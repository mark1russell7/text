{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/text",
  "version": "0.0.10",
  "description": "Plain text helpers: the escapes for HTML, attributes, patterns, Markdown and workflow commands, English word forms (countOf), a word search (wordSearch), the text of a thrown value (errorMessage), the orders of texts by code units and by code points (compareCodeUnits, compareCodePoints), the removal of secrets (redactSecrets) and the shapes of tokens (findSecretShapes, redactSecretShapes, findSecretShapesInValue), and lengths in code units, code points and graphemes with truncation and padding (textLength, truncate, pad), the marked parts of a text (partsAt, partsOf), and a scan of HTML for its text and its start tags (scanHtml).",
  "keywords": [
    "text",
    "escape",
    "html",
    "regexp",
    "markdown",
    "search",
    "plural",
    "redact",
    "secrets",
    "error",
    "truncate",
    "pad",
    "grapheme",
    "unicode",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/text#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/text.git",
    "directory": "packages/text"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./redact": "./src/redact.ts",
    "./length": "./src/length.ts",
    "./parts": "./src/parts.ts",
    "./order": "./src/order.ts",
    "./html": "./src/html.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./redact": {
        "types": "./build/redact.d.ts",
        "default": "./build/redact.js"
      },
      "./length": {
        "types": "./build/length.d.ts",
        "default": "./build/length.js"
      },
      "./parts": {
        "types": "./build/parts.d.ts",
        "default": "./build/parts.js"
      },
      "./order": {
        "types": "./build/order.d.ts",
        "default": "./build/order.js"
      },
      "./html": {
        "types": "./build/html.d.ts",
        "default": "./build/html.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-generators": "^0.1.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
