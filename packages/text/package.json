{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/text",
  "version": "0.0.21",
  "description": "Plain text helpers: the escapes for HTML, attributes, patterns, Markdown and workflow commands, English word forms (countOf, listOf), a word search (wordSearch), the text of a thrown value (errorMessage), the orders of texts by code units and by code points (compareCodeUnits, compareCodePoints), the removal of secrets (redactSecrets) and the shapes of tokens and of secrets by their context (findSecretShapes, redactSecretShapes, findSecretShapesInValue, CONTEXT_SHAPES, isSecretName), and lengths in code units, code points and graphemes with truncation and padding (textLength, truncate, pad), the marked parts of a text (partsAt, partsOf), a scan of HTML for its text and its start tags (scanHtml) with the decode of its character references (decodeReferences) and its plain text (plainText), and a printer of lines and tables to streams that the caller gives (createPrinter).",
  "keywords": [
    "text",
    "escape",
    "html",
    "entities",
    "regexp",
    "markdown",
    "search",
    "plural",
    "redact",
    "secrets",
    "error",
    "truncate",
    "pad",
    "grapheme",
    "unicode",
    "cli",
    "print",
    "table",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/text#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/text.git",
    "directory": "packages/text"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./redact": "./src/redact.ts",
    "./length": "./src/length.ts",
    "./parts": "./src/parts.ts",
    "./order": "./src/order.ts",
    "./html": "./src/html.ts",
    "./references": "./src/references.ts",
    "./plain-text": "./src/plain-text.ts",
    "./english": "./src/english.ts",
    "./passage": "./src/passage.ts",
    "./search": "./src/search.ts",
    "./shell": "./src/shell.ts",
    "./print": "./src/print.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./redact": {
        "types": "./build/redact.d.ts",
        "default": "./build/redact.js"
      },
      "./length": {
        "types": "./build/length.d.ts",
        "default": "./build/length.js"
      },
      "./parts": {
        "types": "./build/parts.d.ts",
        "default": "./build/parts.js"
      },
      "./order": {
        "types": "./build/order.d.ts",
        "default": "./build/order.js"
      },
      "./html": {
        "types": "./build/html.d.ts",
        "default": "./build/html.js"
      },
      "./references": {
        "types": "./build/references.d.ts",
        "default": "./build/references.js"
      },
      "./plain-text": {
        "types": "./build/plain-text.d.ts",
        "default": "./build/plain-text.js"
      },
      "./english": {
        "types": "./build/english.d.ts",
        "default": "./build/english.js"
      },
      "./passage": {
        "types": "./build/passage.d.ts",
        "default": "./build/passage.js"
      },
      "./search": {
        "types": "./build/search.d.ts",
        "default": "./build/search.js"
      },
      "./shell": {
        "types": "./build/shell.d.ts",
        "default": "./build/shell.js"
      },
      "./print": {
        "types": "./build/print.d.ts",
        "default": "./build/print.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-generators": "^0.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
